REGION:(1,1,79,21),unlit,"ordinary"

$top_wall = selection:fillrect(0,0,29,0)
$bottom_wall = selection:fillrect(0,17,29,17)
$left_wall = selection:fillrect(0,0,0,17)
$right_wall = selection:fillrect(29,0,29,17)

IF [25%] {
   GOLD:10,rndcoord($top_wall)
} ELSE {
  IF [33%] {
     GOLD:10,rndcoord($bottom_wall)
  } ELSE {
     IF [50%] {
     	GOLD:10,rndcoord($left_wall)
     } ELSE {
          GOLD:10,rndcoord($right_wall)
     }
  }
}


STAIR: (16,8),down
BRANCH:(15,8,15,8),(16,9,16,9)
